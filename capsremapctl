#!/bin/bash
# Reads and sets what the Caps Lock key does, for the Caps Lock Remap bar plugin.
#
#   capsremapctl status          print the XKB options Hyprland is using right now
#   capsremapctl set <option>    make <option> the Caps Lock mapping and apply it
#   capsremapctl reset           drop the choice; Caps Lock follows your own config again
#   capsremapctl uninstall       reset, and take the loader line out of hyprland.lua
#
# The choice lives in ~/.config/hypr/caps-lock-remap.lua, loaded from the end
# of hyprland.lua. That file swaps out only the options that bind Caps Lock and
# keeps every other option your config sets (layout switching and so on).

set -euo pipefail

HYPR_DIR="$HOME/.config/hypr"
MAIN="$HYPR_DIR/hyprland.lua"
MANAGED="$HYPR_DIR/caps-lock-remap.lua"
MARKER="io.github.zamia.caps-lock-remap"

die() {
  echo "$*" >&2
  exit 1
}

live_options() {
  hyprctl -j getoption input:kb_options | jq -r '.str // ""'
}

# Only options this plugin offers may be written into the generated Lua.
valid_option() {
  [[ $1 =~ ^(caps:[a-z_]+|ctrl:(nocaps|swapcaps)|compose:caps)$ ]]
}

write_managed() {
  local option=$1 tmp
  tmp=$(mktemp "$MANAGED.XXXXXX")
  cat >"$tmp" <<EOF
-- Generated by the Caps Lock Remap bar plugin ($MARKER) — do not edit by hand.
-- Pick a mapping from the bar icon to change it; delete this file to hand
-- Caps Lock back to the rest of your config.

local choice = "$option"

-- Every XKB option that decides what the Caps Lock key does. Keep in sync
-- with CAPS_PATTERNS in the plugin's Model.js.
local caps_patterns = {
  "^caps:",
  "^ctrl:[%a_]*caps",
  "^compose:caps\$",
  "^grp:caps_",
  "^lv[35]:caps_switch",
}

local function binds_caps(option)
  for _, pattern in ipairs(caps_patterns) do
    if option:find(pattern) then
      return true
    end
  end
  return false
end

-- Start from whatever was set before this file loaded, drop the options that
-- bind Caps Lock, and add the chosen one. Everything else is left alone.
local kept = {}
for option in (hl.get_config("input.kb_options") or ""):gmatch("[^,%s]+") do
  if not binds_caps(option) then
    kept[#kept + 1] = option
  end
end
kept[#kept + 1] = choice

hl.config({ input = { kb_options = table.concat(kept, ",") } })
EOF
  mv "$tmp" "$MANAGED"
}

# The loader line tolerates a missing file, so deleting caps-lock-remap.lua is
# a clean way back to the user's own config.
ensure_loaded() {
  [[ -f $MAIN ]] || die "Caps Lock Remap needs Hyprland's Lua config ($MAIN not found)"
  grep -qF "$MARKER" "$MAIN" && return 0

  cp "$MAIN" "$MAIN.bak.$(date +%s)"
  cat >>"$MAIN" <<EOF

-- Added by the Caps Lock Remap bar plugin ($MARKER): applies the mapping picked from the bar icon.
do local path = os.getenv("HOME") .. "/.config/hypr/caps-lock-remap.lua"; local file = io.open(path, "r"); if file then file:close(); dofile(path) end end
EOF
}

reload() {
  hyprctl reload config-only >/dev/null
}

cmd_set() {
  local option=${1:-} previous=""
  valid_option "$option" || die "Not a Caps Lock option: ${option:-(none)}"

  ensure_loaded
  [[ -f $MANAGED ]] && previous=$(<"$MANAGED")
  write_managed "$option"
  reload

  # The option showing up in the live config is the only proof that counts.
  # Anything else means Hyprland stopped reading the file, so put it back.
  if [[ ",$(live_options)," != *",$option,"* ]]; then
    if [[ -n $previous ]]; then
      printf '%s\n' "$previous" >"$MANAGED"
    else
      rm -f "$MANAGED"
    fi
    reload || true
    die "Hyprland did not accept $option; the previous mapping is back"
  fi

  live_options
}

cmd_reset() {
  rm -f "$MANAGED"
  reload
  live_options
}

# Both lines ensure_loaded added carry one of these two strings, and nothing
# else in a hyprland.lua has a reason to.
cmd_uninstall() {
  local tmp
  rm -f "$MANAGED"
  if [[ -f $MAIN ]] && grep -qF "$MARKER" "$MAIN"; then
    cp "$MAIN" "$MAIN.bak.$(date +%s)"
    tmp=$(mktemp "$MAIN.XXXXXX")
    grep -vF -e "$MARKER" -e "/.config/hypr/caps-lock-remap.lua" "$MAIN" >"$tmp" || true
    cat "$tmp" >"$MAIN"
    rm -f "$tmp"
  fi
  reload
  live_options
}

case "${1:-}" in
  status) live_options ;;
  set) cmd_set "${2:-}" ;;
  reset) cmd_reset ;;
  uninstall) cmd_uninstall ;;
  *) die "Usage: capsremapctl status | set <option> | reset | uninstall" ;;
esac
